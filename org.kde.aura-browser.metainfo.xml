<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
  <id>org.kde.aura-browser</id>
  <name>Aura Browser</name>
  <summary>Browse the web from your couch</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <recommends>
    <control>gamepad</control>
    <control>tv-remote</control>
  </recommends>
  <description>
    <p>
      Browser for a fully immersed Big Screen experience allowing you to navigate the world wide web using just your remote control
    </p>
  </description>
  <project_group>KDE</project_group>
  <developer id="org.kde">
    <name>KDE</name>
  </developer>
  <url type="homepage">https://invent.kde.org/plasma/aura-browser</url>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">org.kde.aura-browser.desktop</launchable>
  <provides>
    <binary>aura-browser</binary>
    <id>org.kde.invent.aura_browser</id>
  </provides>
  <screenshots>
    <screenshot type="default">
      <caption>Aura Browser</caption>
      <image>https://cdn.kde.org/screenshots/aura-browser/aura-browser.png</image>
    </screenshot>
  </screenshots>
  <releases>
    <release version="5.27.12" date="2025-01-06"/>
    <release version="5.27.11" date="2024-03-06"/>
    <release version="5.27.10" date="2023-12-05"/>
  </releases>
</component>
